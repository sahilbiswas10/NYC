# Required for MongoDB Atlas or another MongoDB deployment.
# Local fallback is mongodb://127.0.0.1:27017/lms_platform
MONGO_URI=mongodb://127.0.0.1:27017/lms_platform

# Use a long random value in deployed environments (at least 32 bytes).
JWT_SECRET=replace_with_a_long_random_secret

# Server port; defaults to 5000.
PORT=5000

# Optional upload/processing limits.
MAX_UPLOAD_SIZE_MB=2048
MAX_CONCURRENT_JOBS=2

# Optional Razorpay checkout settings. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
